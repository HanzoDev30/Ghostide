<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.listitem.ListItemLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="wrap_content"
    android:layout_width="match_parent">

    <com.google.android.material.listitem.ListItemCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/snippetCard">

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:gravity="center_vertical"
            android:padding="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_height="40dp"
                android:layout_width="40dp"
                android:gravity="center"
                android:textSize="18sp"
                android:textStyle="bold"
                android:id="@+id/tvSnippetPrefix" />

            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                android:layout_weight="1">

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:ellipsize="end"
                    android:textSize="16sp"
                    android:maxLines="1"
                    android:id="@+id/tvSnippetDesc" />

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:id="@+id/tvSnippetBody" />

            </LinearLayout>

            <ImageView
                android:layout_height="24dp"
                android:layout_width="24dp"
                android:src="@drawable/icon_more_vert_round"
                android:padding="4dp"
                android:id="@+id/ivSnippetMore" />

        </LinearLayout>

    </com.google.android.material.listitem.ListItemCardView>

</com.google.android.material.listitem.ListItemLayout>
